# Copy to .env for local development. Never commit real credentials or keys.
APP_ENV=development
LOG_LEVEL=INFO

# Optional local LLM endpoint (e.g. Ollama, vLLM)
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=llama3.3

# Data and Cache directories
DATA_ROOT=./data
DATA_CACHE_DIR=./data/cache
