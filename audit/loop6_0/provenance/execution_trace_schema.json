{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icc-loop6-0-execution-trace-v1",
  "title": "Prospective ICC fit execution trace",
  "type": "object",
  "required": ["schema_version", "run_id", "experiment_id", "source", "data", "sampling", "model", "execution", "output"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "experiment_id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["repository", "commit", "dirty", "config_sha256", "environment_sha256"], "properties": {"repository": {"type": "string", "format": "uri"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"const": false}, "config_sha256": {"$ref": "#/$defs/hash"}, "environment_sha256": {"$ref": "#/$defs/hash"}}, "additionalProperties": true},
    "data": {"type": "object", "required": ["dataset_id", "source_uri", "source_version", "raw_sha256", "feature_sha256", "ordered_sample_ids_sha256", "labels_sha256", "rights_decision_id"], "properties": {"dataset_id": {"type": "string"}, "source_uri": {"type": "string"}, "source_version": {"type": ["string", "null"]}, "raw_sha256": {"$ref": "#/$defs/hash"}, "feature_sha256": {"$ref": "#/$defs/hash"}, "ordered_sample_ids_sha256": {"$ref": "#/$defs/hash"}, "labels_sha256": {"$ref": "#/$defs/hash"}, "rights_decision_id": {"type": "string"}}, "additionalProperties": true},
    "sampling": {"type": "object", "required": ["fraction", "replacement", "label_stratified", "label_use_disclosure", "seed", "indices_sha256", "indices_path", "null_transform", "null_seed"], "properties": {"fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "replacement": {"type": "boolean"}, "label_stratified": {"type": "boolean"}, "label_use_disclosure": {"type": "string", "minLength": 1}, "seed": {"type": "integer"}, "indices_sha256": {"$ref": "#/$defs/hash"}, "indices_path": {"type": "string"}, "null_transform": {"type": "string"}, "null_seed": {"type": ["integer", "null"]}}, "additionalProperties": true},
    "model": {"type": "object", "required": ["method_id", "parameters", "requested_k", "k_source", "model_seed", "threads"], "properties": {"method_id": {"type": "string"}, "parameters": {"type": "object"}, "requested_k": {"type": "integer", "minimum": 2}, "k_source": {"enum": ["fixed", "external_labels", "estimated"]}, "model_seed": {"type": ["integer", "null"]}, "threads": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
    "execution": {"type": "object", "required": ["start_utc", "end_utc", "python_version", "platform", "hardware", "exit_code", "status", "failure_log_sha256"], "properties": {"start_utc": {"type": "string", "format": "date-time"}, "end_utc": {"type": "string", "format": "date-time"}, "python_version": {"type": "string"}, "platform": {"type": "string"}, "hardware": {"type": "object"}, "exit_code": {"type": "integer"}, "status": {"enum": ["success", "failed"]}, "failure_log_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "output": {"type": "object", "required": ["partition_path", "partition_sha256", "n_samples", "observed_k", "cluster_sizes", "assignment_sha256", "external_ari"], "properties": {"partition_path": {"type": "string"}, "partition_sha256": {"$ref": "#/$defs/hash"}, "n_samples": {"type": "integer", "minimum": 1}, "observed_k": {"type": "integer", "minimum": 1}, "cluster_sizes": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "assignment_sha256": {"$ref": "#/$defs/hash"}, "external_ari": {"type": ["number", "null"]}}, "additionalProperties": true}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
